<Window x:Class="WinPEInstallerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinPEInstallerWPF"
        mc:Ignorable="d"
        Title="Windows 11 Custom OS Installer"
        Height="760" Width="1050"
        MinHeight="640" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Общий стиль тёмной/светлой темы для ComboBox (образ ОС и выбор диска) -->
        <Style x:Key="ThemedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" BorderBrush="{TemplateBinding BorderBrush}"
                                          Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border" CornerRadius="4" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <Path Name="Arrow" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextBlock.Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder" Background="{DynamicResource CardBrush}" BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlBorderBrush}" CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" Background="{DynamicResource BgBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS 11 DEPLOYMENT SUITE" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Автоматическая установка ОС и дополнительного софта" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnToggleTheme" Content="Сменить тему" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,6" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Click="BtnToggleTheme_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Основной контент: 2 колонки -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="1. Выберите дистрибутив Windows" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox x:Name="ComboImages" Style="{StaticResource ThemedComboBox}"/>

                    <!-- Выбор целевого диска -->
                    <TextBlock Text="2. Диск для установки" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,16,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboDisks" Grid.Column="0" Style="{StaticResource ThemedComboBox}"
                                  SelectionChanged="ComboDisks_SelectionChanged"/>
                        <Button x:Name="BtnRefreshDisks" Grid.Column="1" Content="⟳" Width="36" Height="36" Margin="6,0,0,0"
                                FontSize="16" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                ToolTip="Обновить список дисков" Click="BtnRefreshDisks_Click" Cursor="Hand"/>
                    </Grid>

                    <TextBlock Text="3. Твики и компоненты (отметьте для применения)"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,16,0,10"/>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <CheckBox x:Name="ChkInstallOffice" IsChecked="True" Margin="0,5" VerticalContentAlignment="Center">
                                <TextBlock Text="Установить Microsoft Office (Word, Excel, PowerPoint)"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkDisableDefender" IsChecked="True" Margin="0,5" VerticalContentAlignment="Center">
                                <TextBlock Text="Отключить Защитник (Windows Defender)"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkRemoveCopilot" IsChecked="True" Margin="0,5" VerticalContentAlignment="Center">
                                <TextBlock Text="Полностью убрать Copilot (ИИ-панель)"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkDisableTelemetry" IsChecked="True" Margin="0,5" VerticalContentAlignment="Center">
                                <TextBlock Text="Отключить телеметрию и сбор данных"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="ChkDisableEdgeStartup" IsChecked="True" Margin="0,5" VerticalContentAlignment="Center">
                                <TextBlock Text="Отключить автозапуск и фоновую работу Edge"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Margin="0,20,0,0" Padding="15"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtInfo"
                                   Text="⚠ Выбранный диск будет полностью очищен: все разделы и данные на нём удалятся."
                                   Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>
                </StackPanel>

                <!-- Правая колонка: категории софта -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="4. Дополнительные приложения (по категориям)"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ListSoft" Background="Transparent" BorderThickness="0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel Margin="0,0,0,14">
                                                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                                                            </Border>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="195" Height="60" Background="{DynamicResource CardBrush}"
                                            CornerRadius="6" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" Margin="4,2" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="11.5" FontWeight="Medium"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="13"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Нижняя панель -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="LblStatus" Text="Ожидание выбора параметров..." Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Medium"/>
                    <ProgressBar x:Name="ProgressInstall" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                 Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource AccentBrush}"
                                 IsIndeterminate="False" BorderThickness="0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnStart" Content="НАЧАТЬ УСТАНОВКУ" Width="180" Height="40"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource ButtonTextBrush}" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Click="BtnStart_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
